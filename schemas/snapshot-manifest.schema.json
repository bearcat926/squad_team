{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Squad Runtime Snapshot Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotHash",
    "boundaryPolicy",
    "symlinkPolicy",
    "environmentFingerprintRef",
    "files",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": "snapshot-manifest/v1" },
    "snapshotHash": { "type": "string" },
    "boundaryPolicy": { "type": "object" },
    "symlinkPolicy": { "type": "object" },
    "environmentFingerprintRef": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "contentHash", "sizeBytes"],
        "properties": {
          "path": { "type": "string" },
          "contentHash": { "type": "string" },
          "sizeBytes": { "type": "integer" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
